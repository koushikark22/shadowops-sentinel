################################################################################
# ShadowOps Sentinel - Demo Validation Queries
# Run these immediately after ingesting sample_output/shadowops_events.jsonl.
################################################################################

################################################################################
# V01 - Confirm events ingested by sourcetype
################################################################################
index=shadowops
| stats count by sourcetype
| sort sourcetype

################################################################################
# V02 - Confirm JSON field extraction works for required demo fields
################################################################################
index=shadowops
| stats count as events dc(agent_id) as distinct_agents dc(correlation_id) as distinct_correlations values(agent_id) as agents values(access_path) as access_paths values(registered_agent) as registered_values values(sensitive_index) as sensitive_values by sourcetype
| sort sourcetype

################################################################################
# V03 - Confirm the malicious Jira ticket is visible
################################################################################
index=shadowops sourcetype="shadowops:jira" ticket_id="JIRA-881"
| table _time ticket_id project user prompt_injection title ticket_body correlation_id risk_signal

################################################################################
# V04 - Confirm the rogue chain has the expected sequence
################################################################################
index=shadowops correlation_id=*
| eval detail=coalesce(search,dest_url,ticket_body,tool_name,action)
| table _time sourcetype agent_id user host action risk_signal detail correlation_id
| sort _time

################################################################################
# V05 - Confirm rule 06 returns critical risk
################################################################################
index=shadowops earliest=-24h
| eval has_prompt_injection=if(prompt_injection="true" OR prompt_injection=1 OR like(lower(ticket_body),"%ignore previous instructions%"),1,0)
| eval has_sensitive_search=if(sourcetype="shadowops:splunk_audit" AND (sensitive_index="true" OR sensitive_index=1 OR like(search,"%customer_payments%") OR like(search,"%prod_secrets%")),1,0)
| eval has_external_egress=if(sourcetype="shadowops:proxy" AND NOT like(dest_domain,"%.corp.local") AND bytes_out>10000,1,0)
| eval has_token=if(isnotnull(token_id),1,0)
| eval unregistered=if(registered_agent="false" OR registered_agent=0 OR registered_agent=false() OR access_path="direct_token",1,0)
| stats earliest(_time) as first_seen latest(_time) as last_seen values(ticket_id) as ticket_id values(agent_id) as agent_id values(user) as users values(host) as hosts values(search) as searches values(dest_domain) as destinations sum(has_prompt_injection) as prompt_injection_events sum(has_sensitive_search) as sensitive_search_events sum(has_external_egress) as external_egress_events sum(has_token) as token_events max(unregistered) as unregistered_or_direct values(risk_signal) as risk_signals by correlation_id
| where isnotnull(correlation_id)
| eval risk_score=0
| eval risk_score=risk_score + if(unregistered_or_direct=1,20,0)
| eval risk_score=risk_score + if(sensitive_search_events>0,25,0)
| eval risk_score=risk_score + if(prompt_injection_events>0,20,0)
| eval risk_score=risk_score + if(external_egress_events>0,20,0)
| eval risk_score=risk_score + if(token_events>0,10,0)
| eval risk_score=risk_score + if(sensitive_search_events>=2,15,0)
| eval risk_score=if(risk_score>100,100,risk_score)
| eval severity=case(risk_score>=80,"critical",risk_score>=60,"high",risk_score>=31,"medium",true(),"low")
| table severity risk_score correlation_id agent_id users hosts ticket_id destinations prompt_injection_events sensitive_search_events external_egress_events searches risk_signals
| sort -risk_score
